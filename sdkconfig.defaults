# --- Power management -------------------------------------------------
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=y

# Keep the sleep entry/exit path in IRAM. Without this, every keep-alive
# wake pays a flash-cache miss penalty, which matters when we surface
# every 10 seconds for hours at a time.
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_RTOS_IDLE_OPT=y

# Power the flash down during light sleep. Nothing executes from flash
# while we are asleep, and this is a meaningful share of idle draw.
CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=y

# --- Console ----------------------------------------------------------
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
